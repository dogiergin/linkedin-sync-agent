# ==============================================================================
# LinkedIn Sync AI Agent Configuration
# ==============================================================================

# Target LinkedIn recent activity URL
LINKEDIN_ACTIVITY_URL=https://www.linkedin.com/in/dogukanergin/recent-activity/all/

# Destination Webhook endpoint on dogukanergin.com
WEBHOOK_URL=https://dogukanergin.com/api/linkedin-webhook

# Optional Webhook Authentication Header / Secret (if your API requires one)
WEBHOOK_SECRET=

# Browser & Scraping Settings
# Set HEADLESS=false if you want to visually observe the browser in action
HEADLESS=true

# Path to Playwright session / storage state (cookies)
SESSION_FILE=data/session.json

# Optional: direct li_at cookie string if not using interactive login
LINKEDIN_LI_AT=

# Scheduling (24h time in HH:MM format for daily sync loop)
SYNC_SCHEDULE_TIME=09:00

# Retry & Timeout configurations
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5
PAGE_TIMEOUT_MS=45000
